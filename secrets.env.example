# Copy to secrets.env (gitignored) — ask the infra teammate for the real values.
APP_PW=         # PostgreSQL password of dormdesk_app (API)
RO_PW=          # PostgreSQL password of dormdesk_ro (Grafana, read-only)
PG_PW=          # PostgreSQL superuser password on db-01
SESSION_SECRET= # 64 hex chars — signs admin session cookies
GRAFANA_PW=     # Grafana admin password on mon-01
LLM_API_KEY=    # shared key between API and ai-01 model server
DUCKDNS_DOMAIN= # e.g. dormdesk-g02 (DuckDNS subdomain)
DUCKDNS_TOKEN=  # DuckDNS account token (for Let's Encrypt DNS-01)
SMTP_USER=      # Gmail address that sends notifications
SMTP_PASS=      # Gmail App Password (16 chars, no spaces)
OWNER_ALERT_TO= # optional: comma list that receives "new request" mails
