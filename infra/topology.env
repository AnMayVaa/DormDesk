# DormDesk topology — the ONE place that lists machines. Scripts read it; Nginx upstream, the SSH tunnel,
# the bastion's permitopen list and the API DSN are GENERATED from it (api-N auto-wiring: infra/scale_api.sh).
# App zone 10.0.2.136/29 (= .137–.142) is what the firewall and pg_hba trust, so API servers must stay inside it.
API_HOSTS="10.0.2.140 10.0.2.141"   # api-01, api-02 (+ api-03 = 10.0.2.142 when scaled out)
DB_PRIMARY=10.0.2.150               # current writable database (failover.sh swaps these two)
DB_STANDBY=10.0.2.151               # streaming-replication hot standby
STORE=10.0.2.155                    # store-01: SeaweedFS S3 object store (photos, slips, fine evidence)
WEB=10.0.2.10
MON=10.0.2.165
AI=10.0.2.160
BASTION_PUB=10.0.2.3
BASTION_PRIV=10.0.2.131
