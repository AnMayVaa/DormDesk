        "type": "gt",
        "params": [
         300
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
  "uid": "dd-backup-stale",
  "title": "Backup older than 26 h",
  "ruleGroup": "dormdesk",
  "folderUID": "dormdesk",
  "condition": "C",
  "for": "0s",
  "noDataState": "OK",
  "execErrState": "Error",
  "labels": {
   "severity": "warning",
   "service": "dormdesk"
  },
  "annotations": {
   "summary": "tools/backup.sh has not completed (with restore test) for more than a day."
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 600,
     "to": 0
    },
    "datasourceUid": "dormdesk-pg",
    "model": {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT coalesce(extract(epoch FROM now() - max(updated_at)) / 3600, 999)::float AS value FROM v_ops_meta WHERE key = 'backup_last_ok'",
     "intervalMs": 60000,
     "maxDataPoints": 43200
    }
   },
   {
    "refId": "C",
    "relativeTimeRange": {
     "from": 0,
     "to": 0
    },
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         26
        ]
       }
      }
     ]
    }
   }
  ]
 },
