 {
  "uid": "dd-standby-lag",
  "title": "Standby lagging",
  "ruleGroup": "dormdesk",
  "folderUID": "dormdesk",
  "condition": "C",
  "for": "2m",
  "noDataState": "OK",
  "execErrState": "Error",
  "labels": {
   "severity": "warning",
   "service": "dormdesk"
  },
  "annotations": {
   "summary": "db standby replayed nothing for > 3 min (heartbeats write every minute, so it is stuck)."
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 600,
     "to": 0
    },
    "datasourceUid": "dormdesk-pg-standby",
    "model": {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT coalesce(last_replay_age_s, 9999)::float AS value FROM ops_replication() WHERE role = 'standby'",
     "intervalMs": 60000,
     "maxDataPoints": 43200
    }
   },
   {
    "refId": "C",
    "relativeTimeRange": {
     "from": 0,
     "to": 0
    },
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         180
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
  "uid": "dd-login-spike",
