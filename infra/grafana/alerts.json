[
 {
  "uid": "dd-api-silent",
  "title": "API server silent",
  "ruleGroup": "dormdesk",
  "folderUID": "dormdesk",
  "condition": "C",
  "for": "2m",
  "noDataState": "OK",
  "execErrState": "Error",
  "labels": {
   "severity": "critical",
   "service": "dormdesk"
  },
  "annotations": {
   "summary": "An API server has not written a heartbeat for > 150 s (crashed, or cannot reach the database)."
  },
  "data": [
   {
    "refId": "A",
    "relativeTimeRange": {
     "from": 600,
     "to": 0
    },
    "datasourceUid": "dormdesk-pg",
    "model": {
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT host, age_s::float AS value FROM v_ops_heartbeats",
     "intervalMs": 60000,
     "maxDataPoints": 43200
    }
   },
   {
    "refId": "C",
    "relativeTimeRange": {
     "from": 0,
     "to": 0
    },
    "datasourceUid": "__expr__",
    "model": {
     "refId": "C",
     "type": "threshold",
     "expression": "A",
     "conditions": [
      {
       "evaluator": {
        "type": "gt",
        "params": [
         150
        ]
       }
      }
     ]
    }
   }
  ]
 },
 {
