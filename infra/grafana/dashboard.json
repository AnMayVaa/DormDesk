{
  "dashboard": {
    "uid": "dormdesk-sec",
    "title": "DormDesk — Security & Operations",
    "timezone": "Asia/Bangkok",
    "refresh": "10s",
    "time": { "from": "now-24h", "to": "now" },
    "schemaVersion": 39,
    "panels": [
      { "type": "stat", "title": "Security events (1 ชม.)", "gridPos": {"x":0,"y":0,"w":6,"h":5},
        "datasource": {"type":"grafana-postgresql-datasource","uid":"dormdesk-pg"},
        "targets": [{ "refId":"A", "format":"table", "rawQuery": true, "editorMode":"code",
          "rawSql": "SELECT count(*) AS events FROM v_security_events WHERE occurred_at > now() - interval '1 hour'" }] },
      { "type": "stat", "title": "Cross-tenant attempts (24 ชม.)", "gridPos": {"x":6,"y":0,"w":6,"h":5},
        "datasource": {"type":"grafana-postgresql-datasource","uid":"dormdesk-pg"},
        "fieldConfig": {"defaults": {"color": {"mode":"thresholds"}, "thresholds": {"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}}},
        "targets": [{ "refId":"A", "format":"table", "rawQuery": true, "editorMode":"code",
          "rawSql": "SELECT count(*) AS attempts FROM v_security_events WHERE type='cross_tenant' AND occurred_at > now() - interval '24 hours'" }] },
      { "type": "stat", "title": "Open requests (all dorms)", "gridPos": {"x":12,"y":0,"w":6,"h":5},
        "datasource": {"type":"grafana-postgresql-datasource","uid":"dormdesk-pg"},
        "targets": [{ "refId":"A", "format":"table", "rawQuery": true, "editorMode":"code",
          "rawSql": "SELECT count(*) AS open FROM v_request_stats WHERE status IN ('received','in_progress')" }] },
      { "type": "stat", "title": "Failed logins (24 ชม.)", "gridPos": {"x":18,"y":0,"w":6,"h":5},
        "datasource": {"type":"grafana-postgresql-datasource","uid":"dormdesk-pg"},
        "fieldConfig": {"defaults": {"color": {"mode":"thresholds"}, "thresholds": {"mode":"absolute","steps":[{"color":"green","value":null},{"color":"orange","value":5}]}}},
        "targets": [{ "refId":"A", "format":"table", "rawQuery": true, "editorMode":"code",
          "rawSql": "SELECT count(*) AS failed FROM v_security_events WHERE type='login_failed' AND occurred_at > now() - interval '24 hours'" }] },
      { "type": "timeseries", "title": "Security events by type (per 5 min)", "gridPos": {"x":0,"y":5,"w":16,"h":9},
        "datasource": {"type":"grafana-postgresql-datasource","uid":"dormdesk-pg"},
        "fieldConfig": {"defaults": {"custom": {"drawStyle":"bars","fillOpacity":80,"stacking":{"mode":"normal"}}}},
        "targets": [{ "refId":"A", "format":"time_series", "rawQuery": true, "editorMode":"code",
          "rawSql": "SELECT $__timeGroupAlias(occurred_at, '5m'), type AS metric, count(*) AS value FROM v_security_events WHERE $__timeFilter(occurred_at) GROUP BY 1, 2 ORDER BY 1" }] },
      { "type": "table", "title": "Latest security events", "gridPos": {"x":16,"y":5,"w":8,"h":9},
        "datasource": {"type":"grafana-postgresql-datasource","uid":"dormdesk-pg"},
        "targets": [{ "refId":"A", "format":"table", "rawQuery": true, "editorMode":"code",
          "rawSql": "SELECT occurred_at AS time, type, dorm_id FROM v_security_events ORDER BY occurred_at DESC LIMIT 20" }] },
      { "type": "barchart", "title": "Requests by status per dorm", "gridPos": {"x":0,"y":14,"w":12,"h":8},
        "datasource": {"type":"grafana-postgresql-datasource","uid":"dormdesk-pg"},
        "options": {"stacking":"normal","xField":"dorm"},
        "targets": [{ "refId":"A", "format":"table", "rawQuery": true, "editorMode":"code",
          "rawSql": "SELECT dorm, count(*) FILTER (WHERE status='received') AS received, count(*) FILTER (WHERE status='in_progress') AS in_progress, count(*) FILTER (WHERE status='done') AS done, count(*) FILTER (WHERE status='rejected') AS rejected FROM v_request_stats GROUP BY dorm ORDER BY dorm" }] },
      { "type": "timeseries", "title": "New requests per day", "gridPos": {"x":12,"y":14,"w":12,"h":8},
        "datasource": {"type":"grafana-postgresql-datasource","uid":"dormdesk-pg"},
        "fieldConfig": {"defaults": {"custom": {"drawStyle":"bars","fillOpacity":70}}},
        "targets": [{ "refId":"A", "format":"time_series", "rawQuery": true, "editorMode":"code",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), dorm AS metric, count(*) AS value FROM v_request_stats WHERE created_at > now() - interval '60 days' GROUP BY 1, 2 ORDER BY 1" }] }
    ]
  },
  "overwrite": true
}
